# versions.env — the ONE place every cfm-edge input is pinned.
#
# Sourced by tools/fetch-sources.sh and the Makefile, rewritten by
# tools/check-deps.py --bump. Never make a build fetch "latest": a pin is
# reviewed (a PR), a build only ever fetches exactly what is written here.
#
#   *_SHA256  release tarballs (nginx: also PGP-verified against keys/nginx/)
#   *_COMMIT  git-pinned components: the tag must resolve to this commit
#
# The Lua stack (LuaJIT2, NDK, lua-nginx-module, lua-resty-core,
# lua-resty-lrucache, lua-cjson, lua-resty-string) is taken as ONE set from OpenResty's own
# util/mirror-tarballs on master: they CI that exact combination against the
# nginx they bundle, so we never hand-pick a pairing (lua-resty-core refuses
# to load against a lua-nginx-module it was not released with).

# The package Release is NOT pinned here: it is the build time in UTC
# (YYYYMMDD.HHMMSS, set by the Makefile), so every build is newer than the last.

NGINX_VERSION=1.31.10
NGINX_SHA256=a9b690957fca84abdae8a9b52d66b1bb459282d7f01fe4b94b498ed8e977bdb3

# Same LTS line and pin as chrismfz/php (bump them together).
OPENSSL_VERSION=3.5.9
OPENSSL_SHA256=603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a

# --- OpenResty set (openresty/openresty util/mirror-tarballs @ 0b91f30, main_ver=1.31.9)
LUAJIT_VERSION=2.1-20261117
LUAJIT_COMMIT=2769af8852a4b32687dfdfc55040c4cb4e6a8417
NDK_VERSION=0.3.6
NDK_COMMIT=3bd7c5619312ca562c5fd5dda238cb8d73bf2a1d
LUA_NGINX_MODULE_VERSION=0.10.32rc8
LUA_NGINX_MODULE_COMMIT=0b5ce7ed53591f212c73378a027dd65e7da3a932
LUA_RESTY_CORE_VERSION=0.1.35rc3
LUA_RESTY_CORE_COMMIT=8c8091a829fc5209980821c3845f936851d5c5e5
LUA_RESTY_LRUCACHE_VERSION=0.15
LUA_RESTY_LRUCACHE_COMMIT=3ff6300e68b73ba20e909c7d16bd839aef2e5a4b
LUA_CJSON_VERSION=2.1.0.20
LUA_CJSON_COMMIT=5f53e878d0441e1555f53060178c61d161079e06
LUA_RESTY_STRING_VERSION=0.19
LUA_RESTY_STRING_COMMIT=282590f58d4c927226492e0211b974d72b759329

# --- Libraries CFM requires that OpenResty does not pick for us
LUA_RESTY_HTTP_VERSION=0.18.0
LUA_RESTY_HTTP_COMMIT=03995ff9a08194d48d446ed2fa099cd6de38fbef
LUA_RESTY_MAXMINDDB_VERSION=1.3.7
LUA_RESTY_MAXMINDDB_COMMIT=46026b3e2e610ee8f082341f6b32d3d8b9e83078

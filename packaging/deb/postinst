#!/bin/sh
# cfm-edge .deb postinst: the rpm's post and posttrans sections, Debian-side.
#
#   configure  seed /etc from the shipped defaults (no dpkg conffile, see
#              packaging/config-files.list), tighten the old logs, create the
#              pid dir, reload systemd, then queue the upgrade restart;
#   triggered  run the upgrade restart (/usr/lib/cfm-edge/upgrade-restart.sh).
#
# The unit is never enabled or started here (the rpm does not either): CFM's
# install-edge.sh and the operator switch edges, not the package.
#
# The upgrade restart is a dpkg trigger, not a direct call, for the reason
# the rpm runs it in posttrans: it must run after the WHOLE dpkg run, when a
# cfm upgraded in the same `apt upgrade` is configured and its daemon
# restarted. Run from configure, it could take the edge out of CFM's DNAT
# while cfm's own postinst restarts the daemon (rigel, 2026-11-23, on the rpm
# side). The script itself never fails, never starts an edge that was not
# running, and defers while the cfm daemon is restarting.
set -e

EDGE_LIB=/usr/lib/cfm-edge
DEFAULTS=/usr/share/cfm-edge/defaults
LIST=/usr/share/cfm-edge/config-files.list
SUMS=/var/lib/cfm-edge/config-files.sha256

# ---------------------------------------------------------------------------
# /etc seeding, the rpm's %config(noreplace). Per file of the list:
#   - missing                       -> install the shipped default;
#   - untouched since we installed  -> replace it with the new default;
#   - edited (by hand or by CFM)    -> keep it; when the default changed, put
#                                      the new one beside it as
#                                      <name>.dpkg-dist (the .rpmnew).
# "Untouched" is the sha256 recorded below when we last installed the file.
# Same logic as cfm's own postinst (cfm packaging/debian/DEBIAN/postinst).
# ---------------------------------------------------------------------------
recorded() { # <path> -> recorded sha256, or nothing
    if [ -f "$SUMS" ]; then
        awk -v n="$1" '$2 == n { print $1; exit }' "$SUMS"
    fi
}

seed_config() {
    [ -f "$LIST" ] || return 0
    mkdir -p "$(dirname "$SUMS")"
    new_sums=$(mktemp "$SUMS.XXXXXX")
    trap 'rm -f "$new_sums"' EXIT
    grep -Ev '^[[:space:]]*(#|$)' "$LIST" | while read -r rel mode; do
        src=$DEFAULTS/$rel
        dst=/$rel
        [ -f "$src" ] || continue
        mkdir -p "$(dirname "$dst")"
        new_sum=$(sha256sum "$src" | cut -d' ' -f1)
        if [ ! -e "$dst" ] && [ ! -L "$dst" ]; then
            install -m "$mode" "$src" "$dst"
            echo "$new_sum $rel" >>"$new_sums"
            continue
        fi
        cur_sum=$(sha256sum "$dst" 2>/dev/null | cut -d' ' -f1)
        old_sum=$(recorded "$rel")
        pristine=0
        if [ "$cur_sum" = "$new_sum" ]; then
            pristine=1
        elif [ -n "$old_sum" ] && [ "$old_sum" != "-" ] && [ "$cur_sum" = "$old_sum" ]; then
            pristine=1
        fi
        # A symlinked file is never replaced (mv would swap the link for a
        # plain file): it gets the .dpkg-dist like an edited one.
        if [ -L "$dst" ] && [ "$cur_sum" != "$new_sum" ]; then pristine=0; fi
        if [ "$pristine" = 1 ]; then
            if [ "$cur_sum" != "$new_sum" ]; then
                # keep the operator's mode and owner, as dpkg and rpm do
                cp "$src" "$dst.dpkg-new"
                chmod --reference="$dst" "$dst.dpkg-new"
                chown --reference="$dst" "$dst.dpkg-new"
                mv -f "$dst.dpkg-new" "$dst"
                echo "cfm-edge: updated $dst to the new default"
            fi
            rm -f "$dst.dpkg-dist"
            echo "$new_sum $rel" >>"$new_sums"
        else
            # The rpm writes .rpmnew only when the packaged default changed;
            # likewise here: no .dpkg-dist when this default is the one the
            # edited file was made from (a reinstall, an upgrade that did not
            # touch it). Without a record, say it once.
            if [ "$new_sum" != "$old_sum" ] && ! cmp -s "$src" "$dst.dpkg-dist" 2>/dev/null; then
                install -m "$mode" "$src" "$dst.dpkg-dist"
                echo "cfm-edge: kept your $dst; the new default is $dst.dpkg-dist"
            fi
            # Still edited: keep the hash of the last version we installed, so
            # a later revert to it reads as untouched again ("-" = none known;
            # the line also tells postrm's purge the file is ours).
            echo "${old_sum:--} $rel" >>"$new_sums"
        fi
    done
    chmod 0644 "$new_sums"
    mv -f "$new_sums" "$SUMS"
    trap - EXIT
}

case "$1" in
configure)
    seed_config
    # Logs written before UMask=0027 were 0644: drop the world bits once, so a
    # visitor's IP and full URL are not readable by every local account.
    chmod o-rwx /var/log/cfm-edge/* 2>/dev/null || :
    # The pid dir exists from the next boot through tmpfiles.d; create it now,
    # before the upgrade restart and before any `cfm-edge -t` CFM runs.
    if command -v systemd-tmpfiles >/dev/null 2>&1; then
        systemd-tmpfiles --create cfm-edge.conf >/dev/null 2>&1 || :
    fi
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload >/dev/null 2>&1 || :
    fi
    # Queue the restart for the end of this dpkg run (see the header); a dpkg
    # too old for triggers runs it now.
    if ! dpkg-trigger --no-await cfm-edge-upgrade-restart 2>/dev/null; then
        [ ! -x "$EDGE_LIB/upgrade-restart.sh" ] || "$EDGE_LIB/upgrade-restart.sh" || :
    fi
    ;;
triggered)
    [ ! -x "$EDGE_LIB/upgrade-restart.sh" ] || "$EDGE_LIB/upgrade-restart.sh" || :
    ;;
abort-upgrade|abort-remove|abort-deconfigure)
    ;;
esac

exit 0

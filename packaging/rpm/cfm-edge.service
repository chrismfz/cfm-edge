[Unit]
Description=CFM edge proxy (nginx + CFM Lua stack)
Documentation=https://github.com/chrismfz/cfm-edge
After=network-online.target remote-fs.target nss-lookup.target
Wants=network-online.target
# Deliberately no Conflicts= with openresty/angie: a stray `systemctl start
# cfm-edge` would then stop the live edge and take every site down. Switching
# edges is the install script's job (it stops one, -t's and starts the other).

[Service]
Type=forking
PIDFile=/run/cfm-edge.pid
ExecStartPre=/usr/sbin/cfm-edge -t -q
ExecStart=/usr/sbin/cfm-edge
ExecReload=/usr/sbin/cfm-edge -t -q
ExecReload=/bin/kill -s HUP $MAINPID
KillSignal=SIGQUIT
KillMode=mixed
# SIGQUIT is a graceful stop: nginx closes its listening sockets at once, then
# workers finish their open requests. 90s, as openresty.service has on the
# fleet; with 5s, every stop or restart would SIGKILL large uploads, websockets
# and cPanel/webmail sessions passing through the edge.
# The cost: one long-lived connection (CFM's conf proxies streams with
# proxy_read_timeout 1h) holds a stop for the full 90s, and the ports refuse
# new connections until the next start. The real bound on that window is
# worker_shutdown_timeout in the edge config (ROADMAP.md §1); this is the
# backstop. A reload (HUP) is unaffected: the old workers drain while the new
# ones already serve.
TimeoutStopSec=90
# Match openresty.service. CFM's config also sets worker_rlimit_nofile, which
# the workers apply before dropping privileges; the unit limit means the edge
# does not depend on that line staying there.
LimitNOFILE=262144
Restart=on-failure
RestartSec=2
PrivateTmp=true

[Install]
WantedBy=multi-user.target

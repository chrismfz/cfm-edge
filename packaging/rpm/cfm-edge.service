[Unit]
Description=CFM edge proxy (nginx + CFM Lua stack)
Documentation=https://github.com/chrismfz/cfm-edge
After=network-online.target remote-fs.target nss-lookup.target
Wants=network-online.target
# Deliberately no Conflicts= with openresty/angie: a stray `systemctl start
# cfm-edge` would then stop the live edge and take every site down. Switching
# edges is the install script's job (it stops one, -t's and starts the other).

[Service]
Type=forking
# The pid lives in /run/cfm-edge, the package's compiled --pid-path: /run
# itself is read-only in the sandbox. CFM's config sets no pid (since cfm PR
# #1755), so the compiled default applies; a config that sets one fails the
# start with "Read-only file system" (upgrade-restart.sh refuses to restart
# into it). RuntimeDirectory makes the dir writable inside the sandbox. It
# must also EXIST while the edge is stopped: `cfm-edge -t` opens the pid file
# (create-or-open), and CFM runs -t outside the unit while the edge is not
# running (cfm-edge-listen-v6.service before every start, the install script,
# the panel self-test). So tmpfiles.d creates it at boot, and it is kept at
# stop (RuntimeDirectoryPreserve).
PIDFile=/run/cfm-edge/cfm-edge.pid
RuntimeDirectory=cfm-edge
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStartPre=/usr/sbin/cfm-edge -t -q
ExecStart=/usr/sbin/cfm-edge
ExecReload=/usr/sbin/cfm-edge -t -q
ExecReload=/bin/kill -s HUP $MAINPID
KillSignal=SIGQUIT
KillMode=mixed
# SIGQUIT is a graceful stop: nginx closes its listening sockets at once, then
# workers finish their open requests. 90s, as openresty.service has on the
# fleet; with 5s, every stop or restart would SIGKILL large uploads, websockets
# and cPanel/webmail sessions passing through the edge.
# The cost: one long-lived connection (CFM's conf proxies streams with
# proxy_read_timeout 1h) holds a stop for the full 90s, and the ports refuse
# new connections until the next start. The real bound on that window is
# worker_shutdown_timeout in the edge config (ROADMAP.md §1); this is the
# backstop. A reload (HUP) is unaffected: the old workers drain while the new
# ones already serve.
TimeoutStopSec=90
# Match openresty.service. CFM's config also sets worker_rlimit_nofile, which
# the workers apply before dropping privileges; the unit limit means the edge
# does not depend on that line staying there.
LimitNOFILE=262144
Restart=on-failure
RestartSec=2

# --- Hardening (ROADMAP.md §2, round 1) ---------------------------------
# Measured live on virgo (CloudLinux 8, systemd 239) and rigel (CloudLinux 9,
# systemd 252), 2026-11-20: restart, reload, uploads into the temp dirs,
# Site Cache, WAF/challenge, sslcollector, panel listeners, IPv4 + IPv6.
# systemd-analyze security: 9.2 UNSAFE -> 4.4/4.5 OK.
#
# Everything is read-only but what the edge writes. A path missing here
# fails at run time, not at start: the edge comes up and a large upload or
# response then gets "Read-only file system" (virgo, 2026-11-20: the body
# and proxy temp dirs were missing for 3 minutes). Before adding a write
# path to CFM's edge config, add it here; before trusting this list, measure
# it (ROADMAP.md §2 has the recipe).
#   /var/log/cfm-edge      logs (opened by the root master)
#   /var/cache/nginx       Site Cache (proxy_cache_path in CFM's config)
#   /var/lib/cfm-edge      compiled-in temp paths
#   /var/lib/cfm/nginx     client_body_temp_path / proxy_temp_path in CFM's config
#   /var/lib/cfm/scanner   ClamAV inline scan: the Lua writes the pending file
#   /run/cfm-edge          pid + lock: the RuntimeDirectory above, made
#                          writable by systemd itself, so not listed. /run stays read-only:
#                          the root master could otherwise write a unit into
#                          /run/systemd/system (a unit load path) and leave
#                          the sandbox. Measured on virgo, 2026-11-22: the pid
#                          was the edge's only write under /run.
# Unix sockets (CFM bridge, sslcollector, ingest, clamd) need no write path:
# connecting to one on a read-only mount works.
ProtectSystem=strict
# /run is listed read-only because ProtectSystem=strict does not keep it so
# here: on systemd 252 (EL9) and 257 (EL10), adding ProtectKernelTunables= or
# ProtectControlGroups= (both below) leaves the /run tmpfs rw in the
# namespace, /run/systemd/system included (measured 2026-11-23 on rigel and
# qualityweb; strict alone, and EL8's 239 with all three, make it ro).
# /run/cfm-edge (RuntimeDirectory, more specific) stays writable.
ReadOnlyPaths=/run
ReadWritePaths=/var/log/cfm-edge /var/cache/nginx /var/lib/cfm-edge /var/lib/cfm/nginx /var/lib/cfm/scanner
# The logs opened at start (every visitor's IP and full URL) and the pid are
# not world-readable. Only those: nginx calls umask(0) when it daemonizes
# (measured on virgo, 2026-11-23: master and workers at Umask 0000), so what
# it opens later takes nginx's own modes (a log reopened on USR1 or HUP that
# does not exist yet is 0644). The rotated logs are covered by logrotate's
# `create 0640`, which makes each new file before the USR1.
UMask=0027
# The edge never reads /home: on a cPanel server that is every customer's site.
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
# The root master switches the workers to `cfm`, creates the temp dirs for
# them and signals them; the workers raise their nofile limit. No
# CAP_NET_BIND_SERVICE: every listener in CFM's config is above 1024 (9043,
# 9080, 1208x, 12095/6, 12222 on all 8 nodes, 2026-11-23), so a listen below
# 1024 now fails the start with "Permission denied" naming the port.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_CHOWN CAP_DAC_OVERRIDE CAP_KILL CAP_SYS_RESOURCE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# Unknown to EL8's systemd 239, which logs "Unknown lvalue" and ignores the
# line; they apply on EL9/EL10 (measured on rigel).
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
# The workers see only their own user's processes in /proc (hidepid); CFM's
# edge Lua reads only /proc/self (sslcollector's RSS). Canary on rigel,
# 2026-11-23: a `cfm` shell in the worker's namespace saw 11 of 734 pids.
# EL8's 239 does not know it either and ignores the line.
ProtectProc=invisible
# Not set, on purpose: MemoryDenyWriteExecute (LuaJIT's JIT writes machine
# code at run time) and SystemCallFilter (round 2, measured on its own).

[Install]
WantedBy=multi-user.target

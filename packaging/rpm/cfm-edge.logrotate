# Package-owned rotation of the package's own log dir. CFM's
# check_logrotate_coverage.sh must list /var/log/cfm-edge/ as vendor-rotated
# (never a second declaration of these files: logrotate aborts on duplicates).
#
# A busy edge writes tens of GB a day. `maxsize` caps a log between daily
# runs, but only fires when logrotate runs: CFM's hourly pass
# (/etc/cron.hourly/cfm-logrotate) runs this file too, as it does CFM's own
# config for the OpenResty logs (the same 2G cap, 7 generations).
# delaycompress stays: the edge reopens its logs on USR1 (asynchronously), so
# compressing the just-rotated file at once could race the workers' last
# writes to it. The cost is one uncompressed generation of at most 2G.
#
# dateext + dateformat are set HERE, not left to /etc/logrotate.conf: the
# hourly pass runs this file alone (no global defaults), so without them it
# named generations .1/.2 while the distro's daily run named them -YYYYMMDD,
# and `rotate 7` then kept 7 of EACH. The format goes down to the second:
# a second rotation in one day (the hourly pass, or a size cap) must not hit
# "destination already exists", which fails the whole run.
/var/log/cfm-edge/*.log {
    daily
    maxsize 2G
    rotate 7
    dateext
    dateformat -%Y%m%d-%H%M%S
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    postrotate
        [ -s /run/cfm-edge.pid ] && kill -USR1 "$(cat /run/cfm-edge.pid)" 2>/dev/null || true
    endscript
}
